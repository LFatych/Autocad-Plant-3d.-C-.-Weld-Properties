<!--
  SPDS control styles. Colours always come from the active theme (SpdsDark.xaml / SpdsLight.xaml)
  through DynamicResource, so every style works in both themes.
  Keyed styles: Spds.Button, Spds.Button.Chrome, Spds.Button.Primary, Spds.Button.Icon, Spds.Button.Pick, Spds.Pill,
  Spds.TextBox, Spds.CheckBox, Spds.Card, Spds.Text.*. Implicit styles: PropertyChip, DropZone.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WeldPropUtils.UI.Controls">

    <FontFamily x:Key="Spds.Font.Heading">Century Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="Spds.Font.Body">Segoe UI</FontFamily>
    <FontFamily x:Key="Spds.Font.Mono">Consolas</FontFamily>
    <BooleanToVisibilityConverter x:Key="Spds.BoolToVisibility" />

    <!-- ===== Text ===== -->
    <Style x:Key="Spds.Text.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Spds.Font.Heading}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Text}" />
    </Style>
    <Style x:Key="Spds.Text.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Spds.Text.Faint" TargetType="TextBlock" BasedOn="{StaticResource Spds.Text.Muted}">
        <Setter Property="Foreground" Value="{DynamicResource Spds.Faint}" />
    </Style>
    <Style x:Key="Spds.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Spds.Font.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Mono}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Spds.Button" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Spds.Button.Chrome" TargetType="ButtonBase" BasedOn="{StaticResource Spds.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Spds.ChromeText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.ChromeBorder}" />
    </Style>

    <Style x:Key="Spds.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Spds.Button}">
        <Setter Property="Background" Value="{DynamicResource Spds.PrimaryBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.PrimaryText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.PrimaryBorder}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Spds.Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Spds.Button}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Muted}" />
    </Style>

    <!-- Pill (class tab, profile): DataContext is a PillItem with IsActive. -->
    <Style x:Key="Spds.Pill" TargetType="ButtonBase" BasedOn="{StaticResource Spds.Button}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.TabText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.TabBorder}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Spds.TabOnBg}" />
                <Setter Property="Foreground" Value="{DynamicResource Spds.TabOnText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Spds.TabOnBg}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Weld property in the "+ Add weld property" picker. -->
    <Style x:Key="Spds.Button.Pick" TargetType="ButtonBase" BasedOn="{StaticResource Spds.Button}">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontFamily" Value="{StaticResource Spds.Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Spds.ChipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.ChipBorder}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="Spds.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Spds.FieldBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.BorderStrong}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Spds.Text}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Spds.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Spds.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Containers ===== -->
    <Style x:Key="Spds.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Spds.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ===== Custom controls ===== -->
    <Style TargetType="c:PropertyChip">
        <Setter Property="Background" Value="{DynamicResource Spds.ChipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.ChipBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PropertyChip">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding PropertyName}" FontSize="13" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="{TemplateBinding Scope}" FontSize="11" Foreground="{DynamicResource Spds.Faint}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Spds.SelectedBg}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Spds.SelectedBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:DropZone">
        <Setter Property="Background" Value="{DynamicResource Spds.DropMappedBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Spds.BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Spds.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:DropZone">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="Mapped" Text="{TemplateBinding SourceName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Placeholder" Text="Drop a property here" FontSize="13"
                                       Foreground="{DynamicResource Spds.Faint}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMapped" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Spds.DropEmptyBg}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Spds.DropEmptyBorder}" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Mapped" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMissing" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Spds.Error}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsDragOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Spds.DropOverBg}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Spds.DropOverBorder}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
