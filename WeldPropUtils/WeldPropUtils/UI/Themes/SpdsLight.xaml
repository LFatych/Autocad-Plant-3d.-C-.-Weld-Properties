<!--
  SPDS light theme: brand yellow #FDD541, graphite #44525C (.claude/skills/spds-wpf-ui).
  Both theme files define the same keys; controls use {DynamicResource Spds.*} so switching themes repaints at once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Spds.WindowBg" Color="#F5F4EF" />
    <SolidColorBrush x:Key="Spds.ChromeBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spds.ChromeText" Color="#2E373E" />
    <SolidColorBrush x:Key="Spds.ChromeMuted" Color="#5A6770" />
    <SolidColorBrush x:Key="Spds.ChromeBorder" Color="#C9CFD3" />
    <SolidColorBrush x:Key="Spds.HeaderRule" Color="#FDD541" />
    <SolidColorBrush x:Key="Spds.PanelBg" Color="#EFEEE8" />
    <SolidColorBrush x:Key="Spds.CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spds.FieldBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spds.Border" Color="#D9DCDD" />
    <SolidColorBrush x:Key="Spds.BorderStrong" Color="#B3BABF" />
    <SolidColorBrush x:Key="Spds.Text" Color="#2E373E" />
    <SolidColorBrush x:Key="Spds.Muted" Color="#5A6770" />
    <SolidColorBrush x:Key="Spds.Faint" Color="#5E6B74" />
    <SolidColorBrush x:Key="Spds.Mono" Color="#384650" />
    <SolidColorBrush x:Key="Spds.ChipBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spds.ChipBorder" Color="#D9DCDD" />
    <SolidColorBrush x:Key="Spds.SelectedBg" Color="#FFF1BF" />
    <SolidColorBrush x:Key="Spds.SelectedBorder" Color="#C99A12" />
    <SolidColorBrush x:Key="Spds.DropMappedBg" Color="#F7F6F1" />
    <SolidColorBrush x:Key="Spds.DropEmptyBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spds.DropEmptyBorder" Color="#AEB6BB" />
    <SolidColorBrush x:Key="Spds.DropOverBg" Color="#FFF1BF" />
    <SolidColorBrush x:Key="Spds.DropOverBorder" Color="#44525C" />
    <SolidColorBrush x:Key="Spds.TabBorder" Color="#C9CFD3" />
    <SolidColorBrush x:Key="Spds.TabText" Color="#384650" />
    <SolidColorBrush x:Key="Spds.TabOnBg" Color="#44525C" />
    <SolidColorBrush x:Key="Spds.TabOnText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Spds.Side1" Color="#FDD541" />
    <SolidColorBrush x:Key="Spds.Side1Ring" Color="#B8900F" />
    <SolidColorBrush x:Key="Spds.Side2" Color="#44525C" />
    <SolidColorBrush x:Key="Spds.PrimaryBg" Color="#FDD541" />
    <SolidColorBrush x:Key="Spds.PrimaryText" Color="#2E373E" />
    <SolidColorBrush x:Key="Spds.PrimaryBorder" Color="#E0B21F" />
    <SolidColorBrush x:Key="Spds.NoteBg" Color="#FFF6D6" />
    <SolidColorBrush x:Key="Spds.NoteBorder" Color="#EBCF6A" />
    <SolidColorBrush x:Key="Spds.NoteText" Color="#4A3E12" />
    <SolidColorBrush x:Key="Spds.Unmapped" Color="#B4532A" />
    <SolidColorBrush x:Key="Spds.RowLine" Color="#ECEBE6" />
</ResourceDictionary>
