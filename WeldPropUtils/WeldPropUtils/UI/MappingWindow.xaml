<!--
  Weld Property Mapping window (approved design: .claude/skills/spds-wpf-ui).
  DataContext: MappingViewModel. Theme: MergedDictionaries[0] is swapped between SpdsDark/SpdsLight by the code-behind.
-->
<Window x:Class="WeldPropUtils.UI.MappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WeldPropUtils.UI.Controls"
        Title="Weld Property Mapping"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Spds.WindowBg}"
        Foreground="{DynamicResource Spds.Text}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] = theme, replaced at runtime by MappingWindow.ApplyTheme -->
                <ResourceDictionary Source="/WeldPropUtils;component/UI/Themes/SpdsDark.xaml" />
                <ResourceDictionary Source="/WeldPropUtils;component/UI/Themes/SpdsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One weld field row: name | drop zone | clear. Red when the weld property is not in Project Setup. -->
            <DataTemplate x:Key="TargetRowTemplate">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TargetText" Text="{Binding Target}" Style="{StaticResource Spds.Text.Mono}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                        <TextBlock x:Name="MissingText" Text="not in Project Setup" FontSize="11" Foreground="{DynamicResource Spds.Error}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <c:DropZone Grid.Column="1"
                                TargetName="{Binding Target}"
                                SourceName="{Binding Source}"
                                IsMissing="{Binding MissingInSetup}"
                                DropCommand="{Binding DropCommand}"
                                Command="{Binding ActivateCommand}"
                                AutomationProperties.Name="{Binding Target}" />
                    <Button Grid.Column="2" Content="×" Style="{StaticResource Spds.Button.Icon}" Margin="8,0,0,0"
                            Command="{Binding ClearCommand}" ToolTip="{Binding ClearToolTip}"
                            AutomationProperties.Name="{Binding Target, StringFormat='Clear {0}'}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding MissingInSetup}" Value="True">
                        <Setter TargetName="TargetText" Property="Foreground" Value="{DynamicResource Spds.Error}" />
                        <Setter TargetName="MissingText" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A side card (SideViewModel): rows + "+ Add weld property" picker with the weld class properties from Project Setup. -->
            <DataTemplate x:Key="SideCardTemplate">
                <Border Style="{StaticResource Spds.Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border x:Name="Dot" Width="10" Height="10" CornerRadius="5" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Spds.Side1}" BorderBrush="{DynamicResource Spds.Side1Ring}" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Spds.Text.Heading}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Spds.Text.Muted}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TargetRowTemplate}" />

                        <ToggleButton Content="+ Add weld property" IsChecked="{Binding IsPickerOpen}" HorizontalAlignment="Left"
                                      Style="{StaticResource Spds.Button}" Margin="0,4,0,0"
                                      ToolTip="Add a property of the weld class (from Project Setup) to map on this side" />

                        <Border Padding="10" Margin="0,8,0,0" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource Spds.PanelBg}" BorderBrush="{DynamicResource Spds.Border}"
                                Visibility="{Binding IsPickerOpen, Converter={StaticResource Spds.BoolToVisibility}}">
                            <StackPanel>
                                <TextBox Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Spds.TextBox}"
                                         Margin="0,0,0,8" AutomationProperties.Name="Search weld properties" ToolTip="Search weld properties" />
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Command="{Binding AddCommand}" Style="{StaticResource Spds.Button.Pick}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="No other weld properties found in Project Setup." Style="{StaticResource Spds.Text.Faint}"
                                           Visibility="{Binding HasNoOptions, Converter={StaticResource Spds.BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Spds.Side2}" />
                        <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Spds.Side2}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="PillTemplate">
                <Button Content="{Binding Name}" Command="{Binding SelectCommand}" Style="{StaticResource Spds.Pill}" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Padding="20,10" BorderThickness="0,0,0,2"
                Background="{DynamicResource Spds.ChromeBg}" BorderBrush="{DynamicResource Spds.HeaderRule}">
            <DockPanel>
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource Spds.Button.Chrome}"
                        Click="OnToggleTheme" Content="Light theme" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Weld Property Mapping" FontFamily="{StaticResource Spds.Font.Heading}" FontSize="18"
                               FontWeight="Bold" Foreground="{DynamicResource Spds.ChromeText}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Spds.ChromeMuted}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: connected part properties -->
            <Border Grid.Column="0" Padding="16" BorderThickness="0,0,1,0"
                    Background="{DynamicResource Spds.PanelBg}" BorderBrush="{DynamicResource Spds.Border}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Connected part properties" Style="{StaticResource Spds.Text.Heading}" Margin="0,0,0,10" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Spds.TextBox}"
                                 Margin="0,0,0,10" AutomationProperties.Name="Search properties" ToolTip="Search properties" />
                        <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource PillTemplate}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="No classes could be read from Project Setup." Foreground="{DynamicResource Spds.Unmapped}"
                                   Visibility="{Binding HasNoSources, Converter={StaticResource Spds.BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Spds.Text.Faint}" Margin="0,10,0,0"
                               Text="Properties come from the pipe, fitting, flange, valve and nozzle classes in Project Setup." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:PropertyChip PropertyName="{Binding Name}" Scope="{Binding Scope}"
                                                    IsSelected="{Binding IsSelected, Mode=OneWay}"
                                                    Command="{Binding SelectCommand}"
                                                    AutomationProperties.Name="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Center: weld fields -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Clear all" Command="{Binding ClearAllCommand}" Style="{StaticResource Spds.Button}" />
                        <Button DockPanel.Dock="Right" Content="Remove missing" Command="{Binding RemoveMissingCommand}"
                                Style="{StaticResource Spds.Button}" Margin="8,0,0,0" Foreground="{DynamicResource Spds.Error}"
                                BorderBrush="{DynamicResource Spds.Error}" ToolTip="Remove the rows whose weld property is not in Project Setup"
                                Visibility="{Binding HasMissing, Converter={StaticResource Spds.BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Content="Reset to default" Command="{Binding ResetCommand}"
                                Style="{StaticResource Spds.Button}" Margin="8,0" />
                        <CheckBox Content="Same mapping for both sides" IsChecked="{Binding MirrorSides}"
                                  Style="{StaticResource Spds.CheckBox}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ContentControl Content="{Binding Side1}" ContentTemplate="{StaticResource SideCardTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Side2}" ContentTemplate="{StaticResource SideCardTemplate}" Focusable="False" />

                    <TextBlock Text="WeldNumber is set by the numbering rules (SetWeldNumber), not mapped here."
                               Style="{StaticResource Spds.Text.Muted}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Right: profiles + summary -->
            <Border Grid.Column="2" Padding="16" BorderThickness="1,0,0,0"
                    Background="{DynamicResource Spds.PanelBg}" BorderBrush="{DynamicResource Spds.Border}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Profile" Style="{StaticResource Spds.Text.Heading}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource PillTemplate}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Spds.TextBox}"
                                 Margin="0,0,0,8" AutomationProperties.Name="Profile name" ToolTip="Rename the active profile" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="New profile" Command="{Binding NewProfileCommand}" Style="{StaticResource Spds.Button}" />
                            <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Style="{StaticResource Spds.Button}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Mapping summary" Style="{StaticResource Spds.Text.Heading}" Margin="0,0,0,8" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="10" CornerRadius="6" BorderThickness="1" Margin="0,12,0,0"
                            Background="{DynamicResource Spds.NoteBg}" BorderBrush="{DynamicResource Spds.NoteBorder}">
                        <TextBlock Text="{Binding NoteText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Spds.NoteText}" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border BorderThickness="1" CornerRadius="6" Background="{DynamicResource Spds.CardBg}" BorderBrush="{DynamicResource Spds.Border}">
                            <ItemsControl ItemsSource="{Binding Summary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Spds.RowLine}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SummaryTarget" Text="{Binding Target}" Style="{StaticResource Spds.Text.Mono}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Spds.Text}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding MissingInSetup}" Value="True">
                                                <Setter TargetName="SummaryTarget" Property="Foreground" Value="{DynamicResource Spds.Error}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0"
                Background="{DynamicResource Spds.ChromeBg}" BorderBrush="{DynamicResource Spds.ChromeBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Save and update all welds" Command="{Binding SaveAndUpdateCommand}"
                        Style="{StaticResource Spds.Button.Primary}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}"
                        Style="{StaticResource Spds.Button.Chrome}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"
                        Style="{StaticResource Spds.Button.Chrome}" />
                <CheckBox DockPanel.Dock="Left" Content="Update new welds automatically" IsChecked="{Binding AutoUpdate}"
                          Foreground="{DynamicResource Spds.ChromeText}" VerticalAlignment="Center" Margin="0,0,20,0"
                          ToolTip="When a command creates welds (routing, placing fittings…), fill their mapped properties once the command ends. Project setting; also WeldPropAuto." />
                <TextBlock Text="{Binding HintText}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Spds.ChromeMuted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
