<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plant 3D 2026 plugin (.NET 8).
    Needs the environment variable AP3D_SDK_2026 = Plant 3D 2026 SDK root folder,
    containing inc\AcCoreMgd.dll, AcDbMgd.dll, AcMgd.dll and inc-x64\PnP*.dll.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>WeldPropUtils</RootNamespace>
    <AssemblyName>WeldPropUtils</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Keep Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- Autodesk assemblies are mixed-mode x64 -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <PlantSdk>$(AP3D_SDK_2026)</PlantSdk>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(PlantSdk)\inc\AcCoreMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(PlantSdk)\inc\AcDbMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(PlantSdk)\inc\AcMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PnP3dObjectsMgd"><HintPath>$(PlantSdk)\inc-x64\PnP3dObjectsMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PnP3dProjectPartsMgd"><HintPath>$(PlantSdk)\inc-x64\PnP3dProjectPartsMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PnPDataLinks"><HintPath>$(PlantSdk)\inc-x64\PnPDataLinks.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PnPDataObjects"><HintPath>$(PlantSdk)\inc-x64\PnPDataObjects.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PnPProjectManagerMgd"><HintPath>$(PlantSdk)\inc-x64\PnPProjectManagerMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PnPCommonMgd"><HintPath>$(PlantSdk)\inc-x64\PnPCommonMgd.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
