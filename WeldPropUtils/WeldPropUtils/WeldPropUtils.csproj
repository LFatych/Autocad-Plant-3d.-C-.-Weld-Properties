<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plant 3D 2026 plugin (.NET 8).
    References come from the AutoCAD 2026 install folder (Ac*Mgd.dll in the root, Plant 3D PnP*.dll in PLNT3D\).
    Different install folder: build with -p:AcadDir=... or set an environment variable AcadDir.
    Private=False (Copy Local off) on purpose: AutoCAD already loads these assemblies; copies next to the plugin
    DLL can be loaded a second time and cause type/cast errors at runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>WeldPropUtils</RootNamespace>
    <AssemblyName>WeldPropUtils</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Keep Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- Autodesk assemblies are mixed-mode x64 -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AcadDir>
    <!-- Look in the install folder and its PLNT3D subfolder, wherever each DLL lives. -->
    <AssemblySearchPaths>$(AcadDir);$(AcadDir)\PLNT3D;$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd" Private="False" />
    <Reference Include="AcDbMgd" Private="False" />
    <Reference Include="AcMgd" Private="False" />
    <Reference Include="PnP3dObjectsMgd" Private="False" />
    <Reference Include="PnP3dProjectPartsMgd" Private="False" />
    <Reference Include="PnPDataLinks" Private="False" />
    <Reference Include="PnPDataObjects" Private="False" />
    <Reference Include="PnPProjectManagerMgd" Private="False" />
    <Reference Include="PnPCommonMgd" Private="False" />
  </ItemGroup>
</Project>
